<odoo>

    <!-- VISTA LISTA -->
    <record id="view_gestor_tarea_list" model="ir.ui.view">
        <field name="name">gestor.tarea.list</field>
        <field name="model">gestor.tarea</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fecha_limite"/>
                <field name="prioridad"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORMULARIO -->
    <record id="view_gestor_tarea_form" model="ir.ui.view">
        <field name="name">gestor.tarea.form</field>
        <field name="model">gestor.tarea</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="fecha_limite"/>
                        <field name="prioridad"/>
                        <field name="estado"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA KANBAN -->
    <record id="view_gestor_tarea_kanban" model="ir.ui.view">
        <field name="name">gestor.tarea.kanban</field>
        <field name="model">gestor.tarea</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong>
                                <field name="name"/>
                            </strong>

                            <div>
                                <field name="fecha_limite"/>
                            </div>

                            <div>
                                Prioridad:
                                <field name="prioridad"/>
                            </div>

                            <div>
                                Estado:
                                <field name="estado"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCION -->
    <record id="action_gestor_tarea" model="ir.actions.act_window">
        <field name="name">Tareas</field>
        <field name="res_model">gestor.tarea</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- MENU PRINCIPAL -->
    <menuitem id="menu_gestor_tareas_root"
              name="Gestor de Tareas"/>

    <!-- SUBMENU -->
    <menuitem id="menu_gestor_tareas"
              name="Tareas"
              parent="menu_gestor_tareas_root"
              action="action_gestor_tarea"/>

</odoo>
